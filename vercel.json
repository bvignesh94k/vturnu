{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/cron/crm-daily/", "schedule": "30 3 * * *" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.vturnu.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://vturnu.com/$1"
      }
    },
    {
      "src": "^/(wp-admin|wp-login\\.php|wp-content|wp-includes|xmlrpc\\.php|\\.env|\\.git|phpmyadmin|administrator|vendor/phpunit|cgi-bin|\\.aws|\\.ssh)(/.*)?$",
      "status": 404,
      "dest": "/assets/blocked.txt"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(mj12bot|dotbot|blexbot|petalbot|bytespider|barkrowler|dataforseobot|serpstatbot|megaindex|seekportbot|zoominfobot|omgili|masscan|nikto|sqlmap|zgrab|nmap|wpscan|python-requests|python-urllib|scrapy|go-http-client|libwww-perl|aiohttp|httpx|curl/|wget/).*"
        }
      ],
      "status": 403,
      "dest": "/assets/blocked.txt"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": "(?i).*(semalt|buttons-for-website|darodar|ilovevitaly|best-seo-offer|free-share-buttons|get-free-traffic|traffic2money|seoexperimenta).*"
        }
      ],
      "status": 403,
      "dest": "/assets/blocked.txt"
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=(), usb=()",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Content-Security-Policy": "default-src 'self'; img-src 'self' data: https://cdn.techbehemoths.com https://*.tawk.to https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://*.google-analytics.com https://*.g.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.tawk.to https://www.googletagmanager.com; font-src 'self' https://fonts.gstatic.com https://*.tawk.to data:; script-src 'self' 'unsafe-inline' https://embed.tawk.to https://*.tawk.to https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://*.tawk.to wss://*.tawk.to https://www.google.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net; frame-src https://*.tawk.to https://www.google.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
      },
      "continue": true
    },
    {
      "src": "^/assets/.*\\.(css|js)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/assets/.*\\.(jpg|jpeg|png|webp|avif|svg|ico|gif|woff2|woff)$",
      "headers": {
        "Cache-Control": "public, max-age=2592000"
      },
      "continue": true
    },
    {
      "src": "^/presentations/.*$",
      "headers": {
        "X-Robots-Tag": "noindex"
      },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/(storage|includes|templates|bin|db|new|docs)(/.*)?$",
      "status": 404,
      "dest": "/api/index.php"
    },
    {
      "src": "^/index\\.php$",
      "status": 403
    },
    {
      "src": "^/favicon\\.ico$",
      "status": 301,
      "headers": {
        "Location": "/assets/img/vturnu-icon-48.png"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}

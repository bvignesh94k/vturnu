{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "^/(storage|includes|templates|bin|db|new)(/.*)?$", "status": 403 },
    { "src": "^/index\\.php$", "status": 403 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}

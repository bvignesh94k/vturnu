# Local dev-only / server-state directories. Already covered by .gitignore
# for git-connected deploys; listed again here so a direct `vercel` CLI
# deploy from this working directory behaves the same way.
storage/
new/
deploy.sh
.htaccess

# The root index.php is a thin proxy for local XAMPP dev and the VPS deploy
# only. It must NOT ship to Vercel: a file with this exact name at the
# deployment root gets served as a static download (this was the original
# "vturnu.com downloads source code" bug). The leading slash anchors this to
# the repo root only, so api/index.php (the real, executed entry point) is
# unaffected.
/index.php

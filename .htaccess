# VTurnU: Apache rewrite rules (production / XAMPP)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Canonical host: www always redirects to the bare domain, permanently.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Admin panel: explicit trailing slash for /admin (before generic rules)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^admin$ /admin/ [L,R=301]

    # Canonical trailing slash: /seo -> /seo/, permanently.
    # Without this, index.php's trim($uri, '/') serves every page at two URLs
    # that both return 200, so crawlers report duplicate titles, duplicate
    # descriptions and one canonical target claimed by several pages.
    # POST is excluded because a 301 would downgrade it to GET and drop the
    # body; real files, directories and anything with an extension
    # (sitemap.xml, robots.txt, llms.txt, feed.xml) are left alone.
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,8}$
    RewriteRule ^(.+[^/])$ $1/ [L,R=301]

    # Never serve lead data or PHP internals directly.
    # Directory-relative (not ^/…) so it holds even if the site is installed
    # under a subfolder rather than the domain root.
    RewriteRule ^(storage|includes|templates)/ - [F,L]

    # Serve existing files/dirs (assets) directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else -> front controller
    RewriteRule ^ index.php [L]
</IfModule>

# Correct MIME types (some hosts don't know the newer ones)
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml            .svg
    AddType image/webp               .webp
    AddType image/avif               .avif
    AddType font/woff2               .woff2
    AddType text/javascript          .js
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # HSTS: only meaningful over TLS, so it is set on secure requests only.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

    # 'unsafe-inline' is required: the page carries JSON-LD blocks, inline
    # style attributes and a small async-CSS onload handler. The remaining
    # directives still block object embedding, base-tag injection and
    # off-site form posts.
    # Third-party origins in use: Google Fonts, reCAPTCHA (google.com/gstatic),
    # Google Tag Manager + the Analytics endpoints it loads, and Tawk.to chat.
    # Anything not listed here is blocked, which is the point of the policy,
    # so adding a new vendor script means adding its origin here too.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.tawk.to https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://*.google-analytics.com https://*.g.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.tawk.to https://www.googletagmanager.com; font-src 'self' https://fonts.gstatic.com https://*.tawk.to data:; script-src 'self' 'unsafe-inline' https://embed.tawk.to https://*.tawk.to https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://*.tawk.to wss://*.tawk.to https://www.google.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net; frame-src https://*.tawk.to https://www.google.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

    # The worker must revalidate, or clients get stuck on an old version.
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Compress text responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Sensible caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    # CSS/JS are requested with a ?v=<mtime> string, so they can cache hard.
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
